<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Generar XML de documentación -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- Ocultar warnings de comentarios faltantes -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Modulo.Seguridad.Application\Modulo.Seguridad.Application.csproj" />
		<ProjectReference Include="..\Modulo.Seguridad.Infrastructure\Modulo.Seguridad.Infrastructure.csproj" />
	</ItemGroup>

	<!-- MUY IMPORTANTE: copiar el XML al publicar -->
	<ItemGroup>
		<None Include="$(DocumentationFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
	</ItemGroup>

</Project>
